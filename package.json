{
  "name": "xproducoes-backend",
  "version": "1.0.0",
  "description": "X Produçoes e Eventos - API Express + Prisma + PostgreSQL",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "npx prisma generate && tsc",
    "start": "node dist/index.js",
    "start:prod": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "prisma:sync": "ts-node sync-app-settings.ts",
    "test": "node -e \"if(process.env.NODE_ENV==='production'){console.log('❌ Testes não são executados em produção');process.exit(1);}else{require('jest').run(['--runInBand']);}\"",
    "test:dev": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:force": "NODE_ENV=test jest --runInBand",
    "seed": "ts-node prisma/seed.ts",
    "check-forbidden": "node ../scripts/check_forbidden_files.js",
    "scan-history-secrets": "node ../scripts/scan_history_secrets.js",
    "config-hooks": "git config core.hooksPath .githooks || true"
  },
  "_comment_prisma": "NOTA: A propriedade 'prisma' está deprecated no Prisma 7, mas ainda não há suporte oficial para prisma.config.ts. Migrar quando o Prisma 7 for lançado.",
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "author": "X Produçoes e Eventos",
  "license": "MIT",
  "engines": {
    "node": ">=18.18.0"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@prisma/client": "^6.14.0",
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/dompurify": "^3.0.5",
    "@types/express": "^5.0.3",
    "@types/jsdom": "^21.1.7",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.3.0",
    "@types/node-fetch": "^2.6.13",
    "@types/nodemailer": "^7.0.1",
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.7.0",
    "compression": "^1.8.1",
    "date-fns": "^4.1.0",
    "dompurify": "^3.2.6",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.4.1",
    "ipaddr.js": "^2.0.1",
    "jsdom": "^26.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "node-fetch": "^2.7.0",
    "nodemailer": "^7.0.5",
    "pino": "^9.7.0",
    "prisma": "^6.14.0",
    "socket.io": "^4.8.1",
    "typescript": "^5.9.2",
    "zod": "^4.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/cors": "^2.8.17",
    "@types/ioredis": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/socket.io": "^3.0.1",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.43.0",
    "@typescript-eslint/parser": "^8.43.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.0.5",
    "pino-pretty": "^13.1.1",
    "postinstall-postinstall": "^2.1.0",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.0",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "typescript-eslint": "^8.43.0"
  },
  "overrides": {
    "glob": "^8.1.0"
  }
}
