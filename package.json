{
  "name": "xproducoes-backend",
  "version": "1.0.0",
  "type": "module",
  "description": "X Produçoes e Eventos - API Express + Prisma + PostgreSQL",
  "main": "dist/index.js",
  "scripts": {
    "dev": "npm run dev:tsx",
    "dev:tsx": "tsx watch src/index.ts",
    "dev:ts-node-dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "dev:detached": "start \"backend\" cmd /k \"npm run dev:tsx\"",
    "build": "node -e \"const fs=require('fs');fs.mkdirSync('.cache/puppeteer',{recursive:true})\" && npx puppeteer browsers install chrome && npm run prisma:generate && node esbuild.config.js",
    "postbuild": "npx prisma db push --accept-data-loss || echo 'Schema already in sync'",
    "start": "node dist/index.js",
    "start:prod": "node dist/index.js",
    "prisma:generate": "npx prisma generate",
    "prisma:migrate": "npx prisma migrate deploy",
    "prisma:studio": "npx prisma studio",
    "test": "node -e \"if(process.env.NODE_ENV==='production'){console.log('❌ Testes não são executados em produção');process.exit(1);}else{require('jest').run();}\"",
    "test:serial": "jest --runInBand",
    "test:integration": "cross-env RUN_INTEGRATION_TESTS=true jest --runInBand",
    "test:dev": "jest",
    "test:watch": "jest --watch",
    "test:force": "NODE_ENV=test jest --runInBand",
    "lint": "eslint src --ext .ts,.js",
    "scan-history-secrets": "node ../scripts/scan_history_secrets.js",
    "config-hooks": "git config core.hooksPath .githooks || true",
    "backup:database": "node ../scripts/disaster-recovery.js backup",
    "restore:database": "node ../scripts/disaster-recovery.js restore",
    "verify:backup": "node ../scripts/disaster-recovery.js verify",
    "list:backups": "node ../scripts/disaster-recovery.js list",
    "check:database-integrity": "node ../scripts/disaster-recovery.js check"
  },
  "author": "X Produçoes e Eventos",
  "license": "MIT",
  "engines": {
    "node": "20.x"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@huggingface/inference": "^4.13.11",
    "@prisma/adapter-pg": "^7.3.0",
    "@prisma/client": "7.3.0",
    "@sentry/node": "^10.38.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/dompurify": "^3.0.5",
    "@types/express": "^5.0.3",
    "@types/jsdom": "^21.1.7",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.0.0",
    "@types/node-fetch": "^2.6.13",
    "@types/nodemailer": "^7.0.1",
    "@types/pg": "^8.16.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.67.2",
    "cloudinary": "^2.7.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "date-fns": "^4.1.0",
    "dompurify": "^3.2.6",
    "dotenv": "^17.2.3",
    "esbuild": "^0.25.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.1",
    "googleapis": "^171.0.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.9.2",
    "ipaddr.js": "^2.0.1",
    "jsdom": "^26.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "node-cron": "^4.2.1",
    "node-fetch": "^2.7.0",
    "nodemailer": "^7.0.5",
    "pg": "^8.17.2",
    "pino": "^9.7.0",
    "prisma": "7.3.0",
    "puppeteer": "^24.3.0",
    "qrcode-terminal": "^0.12.0",
    "socket.io": "^4.8.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "systeminformation": "^5.30.7",
    "tslib": "^2.8.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.2",
    "validator": "^13.15.26",
    "whatsapp-web.js": "^1.34.6",
    "xss": "^1.0.15",
    "zod": "^4.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@express-rate-limit/tsconfig": "^1.0.2",
    "@types/cors": "^2.8.17",
    "@types/ioredis": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^25.2.3",
    "@types/node-cron": "^3.0.11",
    "@types/socket.io": "^3.0.1",
    "@types/supertest": "^6.0.3",
    "@types/systeminformation": "^3.23.1",
    "@types/validator": "^13.15.10",
    "@typescript-eslint/eslint-plugin": "^8.43.0",
    "@typescript-eslint/parser": "^8.43.0",
    "cross-env": "^7.0.3",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.0.5",
    "pino-pretty": "^13.1.1",
    "postinstall-postinstall": "^2.1.0",
    "shx": "^0.4.0",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.0",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "typescript-eslint": "^8.43.0"
  },
  "overrides": {
    "glob": "^8.1.0",
    "hono": "^4.12.5",
    "lodash": "^4.17.22"
  }
}
