{
  "name": "xproducoes-backend",
  "version": "1.0.0",
  "description": "Backend X-Produções - API Express + Prisma + PostgreSQL",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "npx prisma generate && tsc",
    "start": "node dist/index.js",
    "start:prod": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "test": "jest --runInBand",
    "seed": "ts-node prisma/seed.ts",
    "migrate:uploads": "ts-node scripts/migrateUploadsToCloudinary.ts",
    "check-forbidden": "node ../scripts/check_forbidden_files.js",
    "scan-history-secrets": "node ../scripts/scan_history_secrets.js",
    "config-hooks": "git config core.hooksPath .githooks || true",
    "check-env": "node scripts/check-env.js",
    "predeploy": "npm run check-env"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "author": "X-Produções",
  "license": "MIT",
  "engines": {
    "node": ">=18.18.0"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@prisma/client": "^6.14.0",
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.7.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "dompurify": "^3.2.6",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.4.1",
    "ipaddr.js": "^2.0.1",
    "jsdom": "^26.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "node-fetch": "^2.7.0",
    "nodemailer": "^7.0.7",
    "pino": "^9.7.0",
    "socket.io": "^4.8.1",
    "zod": "^4.0.14",
    "patch-package": "^8.0.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.17",
    "@types/dompurify": "^3.0.5",
    "@types/express": "^5.0.3",
    "@types/ioredis": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/jsdom": "^21.1.7",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/morgan": "^1.9.4",
    "@types/multer": "^1.4.7",
    "@types/node": "^24.3.0",
    "@types/node-fetch": "^2.6.13",
    "@types/nodemailer": "^6.4.17",
    "@types/socket.io": "^3.0.1",
    "@types/supertest": "^6.0.3",
    "jest": "^30.0.5",
    "pino-pretty": "^13.1.1",
    "postinstall-postinstall": "^2.1.0",
    "prisma": "^6.14.0",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.0",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.2"
  },
  "overrides": {
    "glob": "^8.1.0"
  }
}
