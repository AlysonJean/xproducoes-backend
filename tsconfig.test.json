{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noImplicitAny": false,
    "strict": true,
    "strictNullChecks": false,
    "strictPropertyInitialization": false,
    "strictFunctionTypes": false,
    "skipLibCheck": true,
    "composite": true
  },
  "include": [
    "src/utils/__tests__/**/*.ts",
    "src/**/*.test.ts",
    "src/**/__tests__/**/*.ts"
  ]
}