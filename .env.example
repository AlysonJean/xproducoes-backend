# ═══════════════════════════════════════════════════════════════════════════════
# X-PRODUÇÕES ENVIRONMENT VARIABLES - EXAMPLE
# ═══════════════════════════════════════════════════════════════════════════════
# 
# ⚠️  SECURITY WARNING: 
# - NEVER commit .env files to version control (.gitignore active ✓)
# - Use GitHub Secrets for CI/CD pipelines
# - Rotate all secrets regularly in production
# - Use unique values for each environment (dev, staging, prod)
# - Generate strong secrets: openssl rand -base64 32
#
# ═══════════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────────
# APPLICATION & ENVIRONMENT
# ─────────────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
API_URL=http://localhost:4000
FRONTEND_URL=http://localhost:5173

# ─────────────────────────────────────────────────────────────────────────────
# DATABASE (Neon PostgreSQL - Free Tier)
# ─────────────────────────────────────────────────────────────────────────────
# Format: postgresql://[user[:password]@][host][:port][/database]
# Get from: https://console.neon.tech/
# For production: Set via platform environment variables (Render, Vercel)
DATABASE_URL=postgresql://neondb_owner:password@ep-xxxxx.neon.tech:5432/neondb?sslmode=require

# ─────────────────────────────────────────────────────────────────────────────
# AUTHENTICATION & SECURITY
# ─────────────────────────────────────────────────────────────────────────────
# JWT Secret: MUST be strong (min 32 chars) - generate with: openssl rand -base64 32
JWT_SECRET=REPLACE_WITH_STRONG_32_CHAR_SECRET_IN_PRODUCTION
JWT_EXPIRE=24h
REFRESH_TOKEN_SECRET=REPLACE_WITH_STRONG_REFRESH_SECRET
REFRESH_TOKEN_EXPIRE=7d

# Password policy
STRONG_PASSWORDS=false  # Set to true in production (enforce uppercase, numbers, symbols)

# ─────────────────────────────────────────────────────────────────────────────
# IMAGE UPLOAD (Cloudinary)
# ─────────────────────────────────────────────────────────────────────────────
# Get from: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# EMAIL SERVICE (SMTP)
# ─────────────────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
SMTP_FROM=noreply@xproducoes.com

# ─────────────────────────────────────────────────────────────────────────────
# PAYMENTS (Stripe - Test/Live Keys)
# ─────────────────────────────────────────────────────────────────────────────
# Get from: https://dashboard.stripe.com/
# Use pk_test_*/sk_test_* for development, pk_live_*/sk_live_* for production
STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_WITH_YOUR_KEY
STRIPE_SECRET_KEY=sk_test_REPLACE_WITH_YOUR_KEY
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_WITH_YOUR_SECRET

# ─────────────────────────────────────────────────────────────────────────────
# RATE LIMITING
# ─────────────────────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000    # 60 seconds
RATE_LIMIT_MAX_REQUESTS=1000  # Global limit

# ─────────────────────────────────────────────────────────────────────────────
# CACHE & REDIS (Optional)
# ─────────────────────────────────────────────────────────────────────────────
# Leave empty for in-memory cache (suitable for free tiers)
REDIS_URL=
CACHE_TTL_SHORT=60
CACHE_TTL_MEDIUM=300
CACHE_TTL_LONG=1800

# ─────────────────────────────────────────────────────────────────────────────
# GOOGLE INTEGRATION (Optional)
# ─────────────────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# GEMINI AI (Optional)
# ─────────────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# ERROR TRACKING (Optional but recommended)
# ─────────────────────────────────────────────────────────────────────────────
SENTRY_DSN=

# ─────────────────────────────────────────────────────────────────────────────
# LOGGING
# ─────────────────────────────────────────────────────────────────────────────
LOG_LEVEL=info
RUN_SEED=false

