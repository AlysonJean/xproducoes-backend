# ======= CONFIGURAÇÃO DO BACKEND X-PRODUÇÕES (EXAMPLE) =======
# Copie este arquivo para `.env` localmente e não comite credenciais reais.

NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# FRONTEND
FRONTEND_URL=http://localhost:3000,http://localhost:5173,http://localhost:3001

# Database PostgreSQL (PRODUCTION: defina DATABASE_URL nas Environment Variables do provedor)
# DATABASE_URL=postgresql://postgres:password@localhost:5432/x_producoes_db

# Stripe keys
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx

# JWT
JWT_SECRET=your_jwt_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Gemini AI
GEMINI_API_KEY=your_gemini_api_key_here

# Others
LOG_LEVEL=info
RUN_SEED=false

# Redis Cache (Recomendado via Docker para desenvolvimento robusto)
REDIS_URL=redis://localhost:6379
# Para produção: Upstash Redis ou Redis Cloud (Requer policy 'noeviction')
# UPSTASH_REDIS_REST_URL=https://your-redis-url.upstash.io

# Cache Configuration
CACHE_TTL_MEDIUM=300
CACHE_TTL_LONG=1800
CACHE_TTL_SHORT=60

# SSL/HTTPS Configuration (OPCIONAL - Para produção)
# HTTPS_ENABLED=true
# SSL_CERT_PATH=/path/to/ssl/cert.pem
# SSL_KEY_PATH=/path/to/ssl/private.key
# SSL_CA_PATH=/path/to/ssl/ca-bundle.crt
# SSL_PASSPHRASE=your_ssl_passphrase_if_needed

