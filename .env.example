# ════════════════════════════════════════════════════════════════
#  X-PRODUÇÕES BACKEND - ENVIRONMENT CONFIGURATION (2026)
# ════════════════════════════════════════════════════════════════
#
# 🔐 SECURITY GUIDELINES:
# - NEVER commit .env with real secrets to version control
# - This file (.env) MUST be in .gitignore ✓
# - All production secrets use GitHub Secrets + CI/CD
# - Rotate secrets regularly (monthly for JWT, quarterly for keys)
# - Local development uses SAMPLE/FAKE values only
#
# 🚀 DEPLOYMENT TARGETS:
# - Local: development environment
# - Render: Production backend (free tier: 512MB RAM, Scale-to-Zero)
# - Neon: Production database (free tier: 0.5 credit/compute hour)
# - Vercel: Production frontend (github sync)

# ════════════════════════════════════════════════════════════════
#  APPLICATION
# ════════════════════════════════════════════════════════════════

# Environment type: development, staging, production
NODE_ENV=development

# Server port
PORT=4000

# Server host
HOST=0.0.0.0

# Timezone (IANA format)
TZ=America/Sao_Paulo

# API URL (for links, redirects, CORS)
API_URL=http://localhost:4000
FRONTEND_URL=http://localhost:5173

# ════════════════════════════════════════════════════════════════
#  DATABASE - PostgreSQL (Neon Free Tier)
# ════════════════════════════════════════════════════════════════
#
# Format: postgresql://user:password@host:port/database?sslmode=require
# Neon Dashboard: https://console.neon.tech
#
# 🔐 REGENERATE PASSWORD:
# 1. Neon Console → Project → Roles → Select role
# 2. Click "Reset password" 
# 3. Copy new connection string
# 4. Update BOTH locally and GitHub Secrets
#
# NOTE: Neon free tier SCALES TO ZERO after 5min inactivity
#       (Very important - preserves free compute credits!)

DATABASE_URL=postgresql://neondb_owner:dev_password@localhost:5432/xproducoes?sslmode=disable

# Connection pool settings (critical for free tier)
DATABASE_POOL_SIZE=5
DATABASE_IDLE_TIMEOUT=30

# ════════════════════════════════════════════════════════════════
#  AUTHENTICATION & SECURITY
# ════════════════════════════════════════════════════════════════

# 🔐 JWT SECRET - Sign tokens (MUST be 32+ chars)
# Generate: openssl rand -base64 32
# Change: Monthly (or after breach detection)
JWT_SECRET=dev_jwt_secret_change_me_32_minimum_chars_0123456789ABCDEF

# 🔐 JWT REFRESH SECRET - Separate for refresh tokens
# Generate: openssl rand -base64 32
JWT_REFRESH_SECRET=dev_refresh_secret_change_me_32_chars_0123456789ABCDEF

# Token expiration
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# 🔐 ENCRYPTION KEY - Cifra tokens OAuth em repouso (ex.: User.googleRefreshToken) e os
# snapshots gerados por scripts/backupDbSnapshot.js (ambos exigem a mesma chave).
# Obrigatório em produção (o boot falha sem ele — mesmo padrão do JWT_SECRET).
# Se você girar (rotate) esta chave: tokens OAuth já cifrados com a chave antiga deixam
# de poder ser decifrados (reconecte as integrações depois de trocar), e snapshots de
# backup já tirados só podem ser restaurados guardando a chave antiga separadamente.
# Para cifrar imediatamente tokens OAuth já gravados em texto puro (em vez de esperar o
# próximo reconnect): npm run encrypt:oauth-tokens -- --apply
# Generate: openssl rand -base64 32
ENCRYPTION_KEY=dev_encryption_key_32_chars_minimum_0123456789ABCDEF

# ════════════════════════════════════════════════════════════════
#  EXTERNAL SERVICES - PAYMENT
# ════════════════════════════════════════════════════════════════

# Stripe API Keys
# Dashboard: https://dashboard.stripe.com/
# Status: TEST mode (pk_test_*, sk_test_*) for development
#         LIVE mode (pk_live_*, sk_live_*) for production

STRIPE_PUBLIC_KEY=pk_test_0000000000000000000000000000
STRIPE_SECRET_KEY=sk_test_0000000000000000000000000000
STRIPE_WEBHOOK_SECRET=whsec_0000000000000000000000000000

# ════════════════════════════════════════════════════════════════
#  EXTERNAL SERVICES - STORAGE & CDN
# ════════════════════════════════════════════════════════════════

# 🔐 Cloudinary - Image/Video Hosting
# Profile: https://cloudinary.com/console/settings/credentials
# Obtém: Cloud Name (public), API Key (public), API Secret (🔐 SECRET!)

CLOUDINARY_CLOUD_NAME=xproducoes
CLOUDINARY_API_KEY=123456789000000
CLOUDINARY_API_SECRET=change_me_keep_secret_never_expose

# Upload folder/prefix
CLOUDINARY_UPLOAD_FOLDER=xproducoes_dev

# ════════════════════════════════════════════════════════════════
#  EXTERNAL SERVICES - EMAIL
# ════════════════════════════════════════════════════════════════

# 🔐 SendGrid API Key - Email Delivery
# Dashboard: https://app.sendgrid.com/settings/api_keys
# Permission: Mail Send (minimum required)
# Change: Twice yearly or after breach

SENDGRID_API_KEY=SG.change_me_keep_secret_0000000000000000000000

# Email addresses
SENDGRID_FROM_EMAIL=noreply@xproducoes.com
SENDGRID_FROM_NAME=X-Produções
ADMIN_EMAIL=admin@xproducoes.com
SUPPORT_EMAIL=support@xproducoes.com

# ════════════════════════════════════════════════════════════════
#  EXTERNAL SERVICES - AUTHENTICATION & CALENDAR
# ════════════════════════════════════════════════════════════════

# 🔐 Google OAuth 2.0
# Console: https://console.cloud.google.com
# Scopes: email, calendar, profile
# Change: Semi-annually or if secrets rotated

GOOGLE_OAUTH_CLIENT_ID=123456789.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=change_me_keep_secret_GOCSPX_0000000000000

# Google Calendar API (for event sync)
GOOGLE_CALENDAR_API_KEY=change_me_keep_secret

# ════════════════════════════════════════════════════════════════
#  WHATSAPP WEB (Socket.io + Baileys)
# ════════════════════════════════════════════════════════════════

# WhatsApp session storage
WHATSAPP_SESSION_DIR=./whatsapp_sessions

# Log level: fatal|error|warn|info|debug|trace
WHATSAPP_LOG_LEVEL=info

# Polling interval (avoid < 3s to respect free tier)
WHATSAPP_POLLING_INTERVAL=30000  # 30 seconds

# ════════════════════════════════════════════════════════════════
#  REPUTAÇÃO / AVALIAÇÕES
# ════════════════════════════════════════════════════════════════

# Link direto para deixar avaliação no Google (Google Business Profile → Peça avaliações
# → copiar link curto). Opcional: se não configurado, o pedido automático de avaliação
# pós-evento (ver whatsappService.sendReviewRequest) simplesmente não é enviado.
GOOGLE_REVIEW_LINK=

# ════════════════════════════════════════════════════════════════
#  CACHE - Redis (OPTIONAL in dev/test — MANDATORY in production)
# ════════════════════════════════════════════════════════════════
#
# Leave empty in development/test to use in-memory cache (good for free tiers).
# In production (NODE_ENV=production), the app now REFUSES to boot without
# REDIS_URL or UPSTASH_REDIS_REST_URL set — the login lockout counter and the
# JWT blacklist rely on Redis in production so they are shared across all
# instances; without it they would silently fall back to a per-instance
# in-memory store, letting an attacker bypass lockout by hitting another
# instance, and letting a blacklisted token stay valid on other instances.
# If using Redis Cloud, format: redis://:password@host:port
#
# TTLs in seconds:
# - SHORT: 5 minutes (trending, temp data)
# - MEDIUM: 1 hour (categories, services)
# - LONG: 1 day (static content, configs)

REDIS_URL=

CACHE_TTL_SHORT=300
CACHE_TTL_MEDIUM=3600
CACHE_TTL_LONG=86400

# ════════════════════════════════════════════════════════════════
#  RATE LIMITING
# ════════════════════════════════════════════════════════════════

# Global rate limit: 100 requests per 15 minutes per IP
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Auth endpoints: 5 attempts per 15 minutes (prevent brute force)
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_REQUESTS=5

# Search/Query: 30 per minute
SEARCH_RATE_LIMIT_WINDOW_MS=60000
SEARCH_RATE_LIMIT_MAX_REQUESTS=30

# Upload: 20 per hour (prevent abuse)
UPLOAD_RATE_LIMIT_WINDOW_MS=3600000
UPLOAD_RATE_LIMIT_MAX_REQUESTS=20

# ════════════════════════════════════════════════════════════════
#  CORS & SECURITY HEADERS
# ════════════════════════════════════════════════════════════════

# CORS allowed origins (comma-separated, no spaces)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# HSTS max-age (seconds) - Use 1 year in production
HSTS_MAX_AGE=31536000

# Content Security Policy
CSP_ENABLED=true

# ════════════════════════════════════════════════════════════════
#  MONITORING & LOGGING
# ════════════════════════════════════════════════════════════════

# 🔐 Sentry DSN - Error Tracking (optional)
# Sign up: https://sentry.io
# Only needed for production monitoring
SENTRY_DSN=

# Pino Log Level: fatal|error|warn|info|debug|trace
LOG_LEVEL=info

# Log HTTP requests (verbose in development)
LOG_HTTP_REQUESTS=true

# Request ID header name (for tracing)
REQUEST_ID_HEADER=x-request-id

# 🔐 INTERNAL_API_KEY - Protege /internal/metrics, /internal/dashboard e,
# em produção, a documentação Swagger (/api/docs, /api/docs/v2,
# /api/docs.json, /api/v1/openapi.json). Sem essa variável definida em
# produção, esses endpoints ficam bloqueados (fail-closed), não abertos.
# Generate: openssl rand -base64 32
INTERNAL_API_KEY=

# ════════════════════════════════════════════════════════════════
#  DEPLOYMENT
# ════════════════════════════════════════════════════════════════

# Updated URLs for production
DEPLOYED_URL=https://xproducoes-backend.render.com
DEPLOYED_FRONTEND_URL=https://xproducoes.vercel.app

# ════════════════════════════════════════════════════════════════
#  FEATURE FLAGS
# ════════════════════════════════════════════════════════════════

# Experimental features
FEATURE_GAMIFICATION=true
FEATURE_AI_RECOMMENDATIONS=true
FEATURE_SOCIAL_WALL=true

# ════════════════════════════════════════════════════════════════
#  DEVELOPMENT ONLY (⚠️ Never enable in production!)
# ════════════════════════════════════════════════════════════════

# Debug mode (verbose logging)
DEBUG=false

# Seed database on startup
SEED_DATABASE=false

# Bypass auth for testing (⚠️ DANGEROUS - only dev!)
BYPASS_AUTH=false

# ════════════════════════════════════════════════════════════════
#  PRODUCTION CHECKLIST
# ════════════════════════════════════════════════════════════════
#
# Before deploying to production:
#
# ✅ Database
#    □ Password changed (32+ chars, no defaults)
#    □ PostgreSQL SSL enabled
#    □ Connection pool limits set (5 max for free tier)
#
# ✅ Authentication
#    □ JWT_SECRET generated fresh (openssl rand -base64 32)
#    □ JWT_REFRESH_SECRET generated fresh
#    □ ENCRYPTION_KEY generated fresh
#
# ✅ External Services
#    □ Stripe keys in LIVE mode (not test)
#    □ Cloudinary API secret rotated
#    □ Google OAuth credentials verified
#    □ SendGrid key with restricted permissions
#
# ✅ Security
#    □ NODE_ENV=production
#    □ LOG_LEVEL=error (no stack traces exposed)
#    □ CORS_ORIGINS restricted to your domains
#    □ HSTS_MAX_AGE=31536000 (1 year)
#    □ Rate limits increased for production traffic
#
# ✅ Infrastructure
#    □ GitHub Secrets configured with all 🔐 values
#    □ Database backup configured
#    □ Monitoring/Sentry configured
#    □ Render limits: 512MB RAM, Scale-to-Zero
#    □ Neon: connection pooling enabled, backups on
#
# ✅ Testing
#    □ Load test with production data patterns
#    □ Security headers verified (curl -I)
#    □ API endpoints tested with real credentials
#    □ Email delivery tested (SendGrid)
#    □ Payment flow tested (Stripe)
#
# ════════════════════════════════════════════════════════════════
#  ROTATION SCHEDULE
# ════════════════════════════════════════════════════════════════
#
# JWT_SECRET:           Monthly
# DATABASE password:    Quarterly  
# Stripe/Cloud keys:    Semi-annually
# Google OAuth:         Semi-annually
# All of above:         Immediately after breach detection
#
# ════════════════════════════════════════════════════════════════
# LOGGING
# ─────────────────────────────────────────────────────────────────────────────
LOG_LEVEL=info
RUN_SEED=false

