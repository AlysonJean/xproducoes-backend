# ======= CONFIGURAÇÃO DO BACKEND X-PRODUÇÕES (EXAMPLE) =======
# Copie este arquivo para `.env` localmente e não comite credenciais reais.

NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# FRONTEND
FRONTEND_URL=http://localhost:3000,http://localhost:5173,http://localhost:3001

# Database PostgreSQL (PRODUCTION: defina DATABASE_URL nas Environment Variables do provedor)
# DATABASE_URL=postgresql://postgres:password@localhost:5432/x_producoes_db

# Stripe keys
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx

# JWT
JWT_SECRET=your_jwt_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Others
LOG_LEVEL=info
RUN_SEED=false

