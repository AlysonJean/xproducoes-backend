{
  "root": true,
  "env": {
    "node": true,
    "es2021": true
  },
  "extends": [
    "eslint:recommended",
    "plugin:@typescript-eslint/recommended",
    "prettier"
  ],
  "parser": "@typescript-eslint/parser",
  "plugins": ["@typescript-eslint"],
  "ignorePatterns": [
    "dist/",
    "build/",
    "node_modules/",
    "*.config.js",
    "*.config.ts",
    "*.json",
    "*.md",
    "*.env*",
    "uploads/",
    "logs/",
    "public/",
    "scripts/",
    "docs/",
    "patches/",
    "tests/",
    "prisma/",
    "**/*.test.ts",
    "**/*.test.js"
  ],
  "overrides": [
    {
      "files": ["src/**/*.ts", "src/**/*.js"],
      "excludedFiles": ["**/*.test.ts", "**/*.test.js"]
    }
  ],
  "rules": {
    "@typescript-eslint/no-explicit-any": "off"
  }
}
