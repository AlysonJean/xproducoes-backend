generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Contact {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("newsletter_subscribers")
}

model Portfolio {
  id          String   @id @default(uuid())
  title       String
  description String
  eventDate   DateTime
  imageUrl    String
  slug        String?  @unique
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("portfolios")
}

model Faq {
  id        String   @id @default(cuid())
  question  String
  answer    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("faqs")
}

model User {
id                       String            @id @default(cuid())
name                     String
email                    String            @unique
passwordHash             String
avatarUrl                String?
role                     UserRole          @default(CLIENT)
bio                      String?
location                 String?
// Modelo PortfolioItem fora do User
  website                  String?
  socialLinks              Json?
  verified                 Boolean           @default(false)
  passwordResetToken       String?           @unique
  passwordResetTokenExpiry DateTime?
  emailVerificationToken   String?
  emailVerificationTokenExpiry DateTime?
  profileSettings          Json?
  isVip                   Boolean           @default(false)
  isActive                 Boolean           @default(true)
  
  // Google Calendar Integration
  googleResourceId         String?
  googleRefreshToken       String?
  googleCalendarEmail      String?

  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt
  auditLogs                BookingAuditLog[]
  assignedBookings         Booking[]         @relation("BookingAssignee")
  createdBookings          Booking[]         @relation("BookingCreator")
  clientProfile            Client?
  collaboratorProfile      Collaborator?
  receivedMessages         Message[]         @relation("MessageRecipient")
  sentMessages             Message[]         @relation("MessageSender")
  notifications            Notification[]
  reviews                  Review[]
  chatParticipants         ChatParticipant[]
  sentChatMessages         ChatMessage[]
  chatMessageReads         ChatMessageRead[]
  createdChecklists        Checklist[]           @relation("ChecklistCreator")
  completedChecklistItems  ChecklistItem[]       @relation("ChecklistItemCompleter")
  assignedChecklists       ChecklistAssignment[] @relation("ChecklistAssignee")
  assignedByChecklists     ChecklistAssignment[] @relation("ChecklistAssigner")

  @@index([email])
  @@index([role])
  @@index([role, createdAt])
  @@index([verified, role])
  @@map("users")
}

model Client {
  id                  String           @id @default(cuid())
  phone               String?
  companyName         String?
  industry            String?
  companySize         String?
  address             Json?
  jobTitle            String?
  department          String?
  budget              Json?
  preferredCategories String[]
  eventTypes          String[]
  communicationPrefs  Json?
  totalBookings       Int              @default(0)
  totalSpent          Decimal          @default(0)
  averageRating       Decimal          @default(0)
  completedBookings   Int              @default(0)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  userId              String           @unique
  bookings            Booking[]        @relation("ClientBookings")
  favoriteEquipments  ClientFavorite[]
  user                User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  notifications       Notification[]

  @@index([userId])
  @@map("clients")
}

model Collaborator {
  id               String                     @id @default(cuid())
  phone            String?
  collaboratorRole CollaboratorRole
  specialties      String[]
  status           CollaboratorStatus         @default(PENDING_APPROVAL)
  experience       String?
  portfolio        Json?
  hourlyRate       Decimal?
  equipment        String[]
  certifications   String[]
  workingRadius    Int?
  languages        String[]
  totalEvents      Int                        @default(0)
  totalEarnings    Decimal                    @default(0)
  averageRating    Decimal                    @default(0)
  completedEvents  Int                        @default(0)
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt
  userId           String                     @unique
  availabilities   CollaboratorAvailability[]
  payments         CollaboratorPayment[]
  user             User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventAssignments EventCollaborator[]
  reviews          Review[]                   @relation("CollaboratorReviews")

  @@index([userId])
  @@index([status])
  @@index([collaboratorRole])
  @@index([status, collaboratorRole])
  @@index([userId, status])
  @@map("collaborators")
}

model Equipment {
  id                    String           @id @default(cuid())
  name                  String
  description           String
  imageUrl              String
  slug                  String?           @unique
  pricePerHour          Decimal          @db.Decimal(10, 2)
  quantity              Int
  isAvailable           Boolean          @default(true)
  tags                  String[]
  specifications        Json?
  weight                Decimal?         @db.Decimal(8, 2)
  dimensions            Json?
  powerRequirements     String?
  maintenanceNotes      String?
  maintenanceDate       DateTime?
  purchaseDate          DateTime?
  warrantyExpiration    DateTime?
  condition             String           @default("EXCELLENT")
  serialNumber          String?          @unique
  location              String?
  minimumRentalDuration Int              @default(1)
  replacementCost       Decimal?         @db.Decimal(10, 2)
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  categoryId            String
  clientFavorites       ClientFavorite[]
  category              Category         @relation(fields: [categoryId], references: [id])
  bookings              Booking[]        @relation("BookingEquipments")
  kitItems              KitItem[]

  @@index([categoryId])
  @@index([name])
  @@index([condition])
  @@index([categoryId, condition])
  @@index([pricePerHour])
  @@index([name, categoryId])
  @@map("equipments")
}

model Category {
  id              String      @id @default(cuid())
  name            String      @unique
  slug            String      @unique
  description     String?
  color           String?
  icon            String?
  sortOrder       Int         @default(0)
  active          Boolean     @default(true)
  parentId        String?
  metaTitle       String?
  metaDescription String?
  keywords        String?
  ogImage         String?
  imageUrl        String?
  imageAlt        String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  equipments      Equipment[]

  @@index([active, sortOrder])
  @@index([slug])
  @@index([parentId])
  @@map("categories")
}

model Kit {
  id                    String      @id @default(cuid())
  name                  String
  description           String
  price                 Decimal     @db.Decimal(10, 2)
  imageUrl              String
  slug                  String?      @unique
  category              String?
  tags                  String[]
  minimumRentalDuration Int?
  setupInstructions     String?
  targetAudience        String[]
  skillLevel            String?
  estimatedSetupTime    Int?
  weight                Decimal?    @db.Decimal(8, 2)
  transportRequirements String?
  isAvailable           Boolean     @default(true)
  coverImage            String?
  images                String[]
  setupGuides           String[]
  recommended           Boolean     @default(false)
  popular               Boolean     @default(false)
  discount              Decimal?    @db.Decimal(5, 2)
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  bookings              Booking[]
  items                 KitItem[]



  @@index([recommended])
  @@index([popular])
  @@map("kits")
}

model Service {
  id          String    @id @default(cuid())
  name        String
  description String
  price       Decimal   @db.Decimal(10, 2)
  duration    Int       @default(60) // Duration in minutes
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  items       KitItem[]

  @@map("services")
}

model Booking {
  id                 String              @id @default(cuid())
  idempotencyKey     String?             @unique
  eventTitle         String?
  eventDate          DateTime
  eventEndDate       DateTime
  totalPrice         Decimal             @db.Decimal(10, 2)
  serviceValue       Decimal?            @db.Decimal(10, 2)
  paymentProofUrl    String?
  status             BookingStatus       @default(DRAFT)
  requiresStairs     Boolean             @default(false)
  isCovered          Boolean             @default(true)
  hasParking         Boolean             @default(true)
  eventDuration      Int?
  location           String?
  street             String?
  neighborhood       String?
  city               String?
  state              String?
  zipCode            String?
  addressNumber      String?
  addressComplement  String?
  clientName         String?
  clientContact      String?
  clientEmail        String?
  notes              String?
  internalNotes      String?
  specialRequests    String?
  deliveryStatus     DeliveryStatus      @default(PENDING)
  setupTime          DateTime?
  pickupTime         DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  clientId           String?
  creatorId          String
  assigneeId         String?
  kitId              String?
  auditLogs          BookingAuditLog[]
  assignee           User?               @relation("BookingAssignee", fields: [assigneeId], references: [id])
  client             Client?             @relation("ClientBookings", fields: [clientId], references: [id])
  creator            User                @relation("BookingCreator", fields: [creatorId], references: [id])
  kit                Kit?                @relation(fields: [kitId], references: [id])
  eventCollaborators EventCollaborator[]
  attachments        BookingAttachment[]
  messages           Message[]
  review             Review?
  equipments         Equipment[]         @relation("BookingEquipments")

  @@index([clientId])
  @@index([creatorId])
  @@index([assigneeId])
  @@index([status])
  @@index([eventDate])
  @@index([deliveryStatus])
  @@index([eventDate, status])
  @@index([creatorId, status])
  @@index([clientId, status])
  @@index([status, eventDate])
  @@index([eventDate, eventEndDate])
  @@map("bookings")
}

model BookingAttachment {
  id         String   @id @default(cuid())
  bookingId  String
  url        String
  filename   String?
  mimeType   String?
  createdAt  DateTime @default(now())

  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@map("booking_attachments")
}

model EventCollaborator {
  id             String                  @id @default(cuid())
  role           CollaboratorRole
  startTime      String
  endTime        String
  hourlyRate     Decimal?                @db.Decimal(8, 2)
  fixedRate      Decimal?                @db.Decimal(10, 2)
  totalHours     Decimal?                @db.Decimal(5, 2)
  totalPayment   Decimal?                @db.Decimal(10, 2)
  status         EventCollaboratorStatus @default(ASSIGNED)
  notes          String?
  rating         Int?
  feedback       String?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  bookingId      String
  collaboratorId String
  booking        Booking                 @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  collaborator   Collaborator            @relation(fields: [collaboratorId], references: [id], onDelete: Cascade)

  @@unique([bookingId, collaboratorId, role])
  @@index([bookingId])
  @@index([collaboratorId])
  @@index([status])
  @@index([bookingId, status])
  @@index([collaboratorId, status])
  @@map("event_collaborators")
}

model ClientFavorite {
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now())
  clientId    String
  equipmentId String
  client      Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@unique([clientId, equipmentId])
  @@index([clientId])
  @@map("client_favorites")
}

model Review {
  id              String        @id @default(cuid())
  rating          Int
  comment         String?
  slug            String?       @unique
  photos          String[]
  tags            String[]
  punctuality     Int?
  professionalism Int?
  quality         Int?
  communication   Int?
  valueForMoney   Int?
  helpful         Int           @default(0)
  reported        Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  bookingId       String        @unique
  reviewerId      String
  collaboratorId  String?
  booking         Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  collaborator    Collaborator? @relation("CollaboratorReviews", fields: [collaboratorId], references: [id])
  reviewer        User          @relation(fields: [reviewerId], references: [id], onDelete: Cascade)

  @@index([reviewerId])
  @@index([collaboratorId])
  @@index([rating])
  @@index([rating, createdAt])
  @@index([collaboratorId, rating])
  @@map("reviews")
}

model Message {
  id          String      @id @default(cuid())
  content     String
  type        MessageType @default(TEXT)
  read        Boolean     @default(false)
  important   Boolean     @default(false)
  attachments Json?
  metadata    Json?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  senderId    String
  recipientId String
  bookingId   String?
  booking     Booking?    @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  recipient   User        @relation("MessageRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  sender      User        @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([senderId])
  @@index([recipientId])
  @@index([bookingId])
  @@index([read])
  @@map("messages")
}

model Notification {
  id        String           @id @default(cuid())
  title     String
  message   String
  type      NotificationType
  read      Boolean          @default(false)
  important Boolean          @default(false)
  actionUrl String?
  metadata  Json?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  userId    String
  clientId  String?
  client    Client?          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([clientId])
  @@index([read])
  @@index([type])
  @@map("notifications")
}

model CollaboratorAvailability {
  id             String             @id @default(cuid())
  date           DateTime           @db.Date
  startTime      String
  endTime        String
  status         AvailabilityStatus
  eventId        String?
  notes          String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  collaboratorId String
  collaborator   Collaborator       @relation(fields: [collaboratorId], references: [id], onDelete: Cascade)

  @@index([collaboratorId])
  @@index([date])
  @@index([status])
  @@map("collaborator_availabilities")
}

model InviteToken {
  id         String   @id @default(cuid())
  token      String   @unique
  email      String
  invitedBy  String?
  used       Boolean  @default(false)
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([email])
  @@map("invite_tokens")
}

model CollaboratorPayment {
  id             String                    @id @default(cuid())
  amount         Decimal                   @db.Decimal(10, 2)
  type           PaymentType               @default(HOURLY)
  description    String
  dueDate        DateTime
  paymentDate    DateTime?
  status         CollaboratorPaymentStatus @default(PENDING)
  notes          String?
  eventId        String
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt
  collaboratorId String
  collaborator   Collaborator              @relation(fields: [collaboratorId], references: [id], onDelete: Cascade)

  @@index([collaboratorId])
  @@index([status])
  @@index([dueDate])
  @@map("collaborator_payments")
}

model BookingAuditLog {
  id        String   @id @default(cuid())
  action    String
  oldValues Json?
  newValues Json?
  timestamp DateTime @default(now())
  bookingId String
  userId    String?
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id])

  @@index([bookingId])
  @@index([userId])
  @@index([timestamp])
  @@index([action])
  @@index([bookingId, timestamp])
  @@index([userId, timestamp])
  @@map("booking_audit_logs")
}

model WebhookLog {
  id           String   @id @default(cuid())
  url          String
  event        String
  payload      Json
  status       String   @default("PENDING")
  responseCode Int?
  responseBody String?
  attempts     Int      @default(0)
  bookingId    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([event])
  @@index([bookingId])
  @@index([status])
  @@index([event, createdAt])
  @@index([status, createdAt])
  @@map("webhook_logs")
}

enum UserRole {
  CLIENT
  COLLABORATOR
  ADMIN
  MANAGER
  OPERATOR
}

enum CollaboratorRole {
  PHOTOGRAPHER
  VIDEOGRAPHER
  SOUND_TECHNICIAN
  LIGHTING_TECHNICIAN
  DJ
  PRESENTER
  COORDINATOR
  ASSISTANT
  SECURITY
  TRANSPORT
  OTHER
}

enum CollaboratorStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_APPROVAL
}

enum BookingStatus {
  DRAFT
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  REFUNDED
}

enum DeliveryStatus {
  PENDING
  PREPARING
  ON_THE_WAY
  ARRIVED
  SETUP_COMPLETE
  PICKUP_PENDING
  COMPLETED
}

enum EventCollaboratorStatus {
  ASSIGNED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum AvailabilityStatus {
  AVAILABLE
  BUSY
  OFF_DUTY
  VACATION
}

enum PaymentType {
  HOURLY
  FIXED
  COMMISSION
  BONUS
  DEDUCTION
}

enum CollaboratorPaymentStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
  DISPUTED
}

enum MessageType {
  TEXT
  IMAGE
  FILE
  SYSTEM
  NOTIFICATION
}

enum NotificationType {
  BOOKING_CREATED
  BOOKING_UPDATED
  BOOKING_CANCELLED
  PAYMENT_DUE
  PAYMENT_RECEIVED
  REVIEW_RECEIVED
  MESSAGE_RECEIVED
  SYSTEM_ALERT
  MAINTENANCE_SCHEDULED
}

// ================================
// MODELOS DE CHAT E COMUNICAÇÃO
// ================================

model Chat {
  id            String            @id @default(cuid())
  name          String?           // Nome do chat (opcional para chats individuais)
  type          ChatType          @default(PRIVATE)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  lastMessageAt DateTime?

  // Relacionamentos
  participants  ChatParticipant[]
  messages      ChatMessage[]

  @@map("chats")
}

model ChatParticipant {
  id        String            @id @default(cuid())
  chatId    String
  userId    String
  role      ChatRole          @default(MEMBER)
  joinedAt  DateTime          @default(now())
  lastReadAt DateTime?

  // Relacionamentos
  chat      Chat              @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([chatId, userId])
  @@map("chat_participants")
}

model ChatMessage {
  id          String            @id @default(cuid())
  chatId      String
  senderId    String
  content     String
  messageType MessageType       @default(TEXT)
  fileUrl     String?
  fileName    String?
  fileSize    Int?
  createdAt   DateTime          @default(now())

  // Relacionamentos
  chat        Chat              @relation(fields: [chatId], references: [id], onDelete: Cascade)
  sender      User              @relation(fields: [senderId], references: [id], onDelete: Cascade)
  reads       ChatMessageRead[]

  @@index([chatId])
  @@index([senderId])
  @@index([chatId, createdAt])
  @@map("chat_messages")
}

model ChatMessageRead {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  chatId    String
  readAt    DateTime @default(now())

  // Relacionamentos
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@map("chat_message_reads")
}

// ================================
// MODELOS DE NOTIFICAÇÕES
// ================================

// Modelo Notification já existe no arquivo, então removemos a duplicata

// ================================
// ENUMS ADICIONAIS
// ================================

enum ChatType {
  PRIVATE     // Chat individual
  GROUP       // Chat em grupo
  EVENT       // Chat relacionado a um evento
  SUPPORT     // Chat de suporte
}

enum ChatRole {
  ADMIN       // Administrador do chat
  MODERATOR   // Moderador
  MEMBER      // Membro comum
}

// ================================
// MODELOS DE CHECKLIST
// ================================

model Checklist {
  id          String               @id @default(cuid())
  title       String
  description String?
  type        ChecklistType        @default(GENERAL)
  status      ChecklistStatus      @default(ACTIVE)
  isTemplate  Boolean              @default(false)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  createdById String
  createdBy   User                 @relation("ChecklistCreator", fields: [createdById], references: [id])

  // Relacionamentos
  items       ChecklistItem[]
  assignments ChecklistAssignment[]

  @@map("checklists")
}

model KitItem {
  id          String    @id @default(cuid())
  kitId       String
  equipmentId String?
  serviceId   String?
  quantity    Int       @default(1)

  kit         Kit       @relation(fields: [kitId], references: [id], onDelete: Cascade)
  equipment   Equipment? @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  service     Service?   @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([kitId])
  @@index([equipmentId])
  @@index([serviceId])
  @@map("kit_items")
}

model ChecklistItem {
  id          String            @id @default(cuid())
  checklistId String
  title       String
  description String?
  order       Int               @default(0)
  isRequired  Boolean           @default(false)
  status      ChecklistItemStatus @default(PENDING)
  completedAt DateTime?
  completedById String?
  notes       String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  // Relacionamentos
  checklist   Checklist          @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  completedBy User?              @relation("ChecklistItemCompleter", fields: [completedById], references: [id])

  @@map("checklist_items")
}

model ChecklistAssignment {
  id            String                @id @default(cuid())
  checklistId   String
  assignedToId  String
  assignedById  String
  dueDate       DateTime?
  priority      ChecklistPriority     @default(MEDIUM)
  status        ChecklistAssignmentStatus @default(PENDING)
  notes         String?
  completedAt   DateTime?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  // Relacionamentos
  checklist     Checklist             @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  assignedTo    User                  @relation("ChecklistAssignee", fields: [assignedToId], references: [id])
  assignedBy    User                  @relation("ChecklistAssigner", fields: [assignedById], references: [id])

  @@unique([checklistId, assignedToId])
  @@map("checklist_assignments")
}

// ================================
// ENUMS DE CHECKLIST
// ================================

enum ChecklistType {
  GENERAL       // Checklist geral
  EVENT_SETUP   // Configuração de evento
  EVENT_BREAKDOWN // Desmontagem de evento
  MAINTENANCE   // Manutenção de equipamento
  CLIENT_MEETING // Reunião com cliente
  DELIVERY      // Entrega de equipamento
  PICKUP        // Retirada de equipamento
  OTHER         // Outro tipo
}

enum ChecklistStatus {
  ACTIVE        // Ativo
  COMPLETED     // Concluído
  ARCHIVED      // Arquivado
  CANCELLED     // Cancelado
}

enum ChecklistItemStatus {
  PENDING       // Pendente
  IN_PROGRESS   // Em andamento
  COMPLETED     // Concluído
  SKIPPED       // Pulado
  CANCELLED     // Cancelado
}

enum ChecklistPriority {
  LOW           // Baixa
  MEDIUM        // Média
  HIGH          // Alta
  URGENT        // Urgente
}

enum ChecklistAssignmentStatus {
  PENDING       // Pendente
  IN_PROGRESS   // Em andamento
  COMPLETED     // Concluído
  OVERDUE       // Atrasado
  CANCELLED     // Cancelado
}

// ================================
// MODELO DE CONFIGURAÇÕES DA APLICAÇÃO
// ================================

model AppSettings {
  id          String   @id @default(cuid())
  logoUrl     String?
  companyName String   @default("X Produçoes e Eventos")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("app_settings")
}

model Banner {
  id             String    @id @default(cuid())
  title          String
  description    String?
  imageUrl       String    
  mobileImageUrl String?
  linkUrl        String?
  active         Boolean   @default(true)
  sortOrder      Int       @default(0)
  startDate      DateTime?
  endDate        DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("banners")
}
